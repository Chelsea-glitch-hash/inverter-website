---
/**
 * OEM / ODM page template — ONE template for all 11 languages.
 *
 * Positioned as a dedicated B2B inquiry page (the missing "OEM / ODM
 * manufacturer" landing page benchmarked from Deye / MUST / LuxPowerTek).
 * All copy lives in the UI dictionary (src/i18n/ui/en.ts → oemOdm block);
 * company facts come from src/config.ts (COMPANY) so nothing is invented.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import CTABanner from '../components/CTABanner.astro';
import { COMPANY } from '../config';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/config';
import { getDict } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getDict(locale).oemOdm;
const seo = getDict(locale).seo.oemOdm;

/* FAQ JSON-LD for GEO/SEO — the same FAQPage pattern used on product pages. */
const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: t.faq.items.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: { '@type': 'Answer', text: item.a },
  })),
};
---

<BaseLayout title={seo.title} description={seo.description} path="/oem-odm/" locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

  <!-- Hero -->
  <section class="bg-gradient-to-b from-brand-50 to-white">
    <Container>
      <div class="grid grid-cols-1 items-center gap-10 py-16 sm:py-20 lg:grid-cols-2 lg:gap-14">
        <div>
          <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-brand-200 bg-white px-3.5 py-1.5 text-xs font-medium text-brand-700">
            <span class="inline-block h-2 w-2 rounded-full bg-accent-500" aria-hidden="true"></span>
            {t.hero.eyebrow}
          </p>
          <h1 class="text-3xl leading-tight font-bold text-slate-900 sm:text-4xl lg:text-5xl">
            {t.hero.title}
          </h1>
          <p class="mt-5 max-w-xl text-base leading-relaxed text-slate-600 sm:text-lg">
            {t.hero.intro}
          </p>
          <div class="mt-8 flex flex-wrap gap-4">
            <Button href={localizedPath(locale, '/contact/')} variant="primary" size="lg" track="click_oem_quote">
              {t.hero.primaryCta}
            </Button>
            <Button href={localizedPath(locale, '/products/')} variant="outline" size="lg">
              {t.hero.secondaryCta}
            </Button>
          </div>
        </div>
        <div class="overflow-hidden rounded-xl border border-slate-200 bg-white">
          <dl class="grid grid-cols-2 gap-px bg-slate-200">
            {
              t.stats.items.map((item) => (
                <div class="flex flex-col justify-center bg-white p-6 text-center">
                  <dt class="order-2 mt-2 text-xs leading-snug text-slate-600">{item.label}</dt>
                  <dd class="order-1 text-2xl font-bold text-brand-700 sm:text-3xl">{item.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="border-t border-slate-200 bg-slate-50 px-6 py-3 text-center text-xs text-slate-500">
            {t.stats.intro}
          </p>
        </div>
      </div>
    </Container>
  </section>

  <!-- Factory capability stats (data-driven, real company facts) -->
  <Section eyebrow={t.stats.eyebrow} title={t.stats.title} class="bg-slate-50">
    <dl class="grid grid-cols-2 gap-4 sm:grid-cols-4">
      <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 text-center">
        <dt class="order-2 mt-2 text-xs leading-snug text-slate-600">Factory area</dt>
        <dd class="order-1 text-2xl font-bold text-brand-700 sm:text-3xl">{COMPANY.factoryAreaSqm.toLocaleString('en-US')} m²</dd>
      </div>
      <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 text-center">
        <dt class="order-2 mt-2 text-xs leading-snug text-slate-600">Annual capacity</dt>
        <dd class="order-1 text-2xl font-bold text-brand-700 sm:text-3xl">{COMPANY.annualCapacityUnits.toLocaleString('en-US')}</dd>
      </div>
      <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 text-center">
        <dt class="order-2 mt-2 text-xs leading-snug text-slate-600">OEM / ODM clients</dt>
        <dd class="order-1 text-2xl font-bold text-brand-700 sm:text-3xl">{COMPANY.oemClients}+</dd>
      </div>
      <div class="flex flex-col rounded-xl border border-slate-200 bg-white p-6 text-center">
        <dt class="order-2 mt-2 text-xs leading-snug text-slate-600">Export countries</dt>
        <dd class="order-1 text-2xl font-bold text-brand-700 sm:text-3xl">{COMPANY.exportCountries}+</dd>
      </div>
    </dl>
  </Section>

  <!-- Services -->
  <Section eyebrow={t.services.eyebrow} title={t.services.title} subtitle={t.services.subtitle}>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
      {
        t.services.items.map((item) => (
          <div class="rounded-xl border border-slate-200 bg-white p-7">
            <h3 class="text-lg font-semibold text-slate-900">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{item.text}</p>
          </div>
        ))
      }
    </div>
  </Section>

  <!-- Process -->
  <Section eyebrow={t.process.eyebrow} title={t.process.title} subtitle={t.process.subtitle} class="bg-slate-50">
    <ol class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-5">
      {
        t.process.steps.map((step, i) => (
          <li class="relative rounded-xl border border-slate-200 bg-white p-6">
            <span class="flex h-9 w-9 items-center justify-center rounded-full bg-brand-600 text-sm font-bold text-white">
              {i + 1}
            </span>
            <p class="mt-3 text-sm leading-relaxed text-slate-700">{step}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- FAQ -->
  <Section eyebrow={t.faq.eyebrow} title={t.faq.title}>
    <div class="mx-auto max-w-3xl divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
      {
        t.faq.items.map((item) => (
          <details class="group px-6 py-5" open={false}>
            <summary class="flex cursor-pointer items-center justify-between gap-4 text-base font-semibold text-slate-900">
              {item.q}
              <svg class="h-5 w-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
              </svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed text-slate-600">{item.a}</p>
          </details>
        ))
      }
    </div>
  </Section>

  <!-- Final CTA -->
  <CTABanner title={getDict(locale).cta.defaultTitle} subtitle={getDict(locale).cta.defaultSubtitle} locale={locale} />
</BaseLayout>

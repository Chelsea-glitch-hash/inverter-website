---
/**
 * Contact / Request a Quote template — ONE template for all 11 languages.
 * Company facts (email / WhatsApp / phone) stay in src/config.ts — one copy
 * only, never translated.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { getProductOptions } from '../lib/products';
import { CONTACT, SOCIAL } from '../config';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { getDict } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getDict(locale);
const seo = t.seo.contact;

const productOptions = getProductOptions();
---

<BaseLayout title={seo.title} description={seo.description} path="/contact/" locale={locale}>
  <Container class="pt-8">
    <Breadcrumb crumbs={[{ label: t.contact.title }]} locale={locale} />
  </Container>

  <Section eyebrow={t.contact.eyebrow} title={t.contact.title} subtitle={t.contact.subtitle}>
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <InquiryForm productOptions={productOptions} locale={locale} />
      </div>

      <div class="space-y-6 lg:col-span-2">
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-6">
          <h3 class="text-base font-semibold text-slate-900">{t.contact.directContact}</h3>
          <ul class="mt-4 space-y-3 text-sm text-slate-700">
            <li>
              <span class="block text-xs font-medium text-slate-500 uppercase">{t.contact.email}</span>
              <a
                href={`mailto:${CONTACT.email}`}
                class="font-medium text-brand-700 hover:underline"
                data-track="click_email"
              >
                {CONTACT.email}
              </a>
            </li>
            {
              CONTACT.whatsapp && (
                <li>
                  <span class="block text-xs font-medium text-slate-500 uppercase">{t.contact.whatsapp}</span>
                  <a
                    href={`https://wa.me/${CONTACT.whatsapp}`}
                    class="font-medium text-brand-700 hover:underline"
                    rel="noopener"
                    target="_blank"
                    data-track="click_whatsapp"
                  >
                    +{CONTACT.whatsapp}
                  </a>
                </li>
              )
            }
            <li>
              <span class="block text-xs font-medium text-slate-500 uppercase">{t.contact.phone}</span>
              <span class="font-medium text-slate-900">{CONTACT.phone}</span>
            </li>
            <li>
              <span class="block text-xs font-medium text-slate-500 uppercase">{t.contact.responseTime}</span>
              <span class="font-medium text-slate-900">{t.contact.responseTimeValue}</span>
            </li>
          </ul>
          {
            SOCIAL.linkedin && (
              <a href={SOCIAL.linkedin} class="mt-4 inline-block text-sm font-medium text-brand-700 hover:underline" rel="noopener" target="_blank">
                {t.contact.linkedin} &rarr;
              </a>
            )
          }
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="text-base font-semibold text-slate-900">{t.contact.beforeYouWrite}</h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-slate-600">
            {t.contact.tips.map((tip) => <li>• {tip}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

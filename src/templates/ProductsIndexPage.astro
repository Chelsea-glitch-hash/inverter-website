---
/**
 * /products/ catalog template — ONE template for all 11 languages.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';
import CTABanner from '../components/CTABanner.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import ProductGrid from '../components/ProductGrid.astro';
import { countProductsByCategory, getCategoriesWithProducts, getProductsByCategory } from '../lib/products';
import { localizedProduct } from '../i18n/product-content';
import { localizedCategory } from '../i18n/category-content';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/config';
import { getDict } from '../i18n';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getDict(locale);

const categories = getCategoriesWithProducts().map((c) => localizedCategory(c, locale));
---

<BaseLayout
  title={t.seo.productsIndex.title}
  description={t.seo.productsIndex.description}
  path="/products/"
  locale={locale}
>
  <Container class="pt-8">
    <Breadcrumb crumbs={[{ label: t.nav.products }]} locale={locale} />
  </Container>

  <Section eyebrow={t.productsIndex.eyebrow} title={t.productsIndex.title} subtitle={t.productsIndex.subtitle}>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        categories.map((c) => (
          <a
            href={localizedPath(locale, `/products/${c.slug}/`)}
            class="group flex items-center justify-between rounded-xl border border-slate-200 bg-slate-50 p-5 transition-colors hover:border-brand-400 hover:bg-brand-50"
          >
            <div>
              <h3 class="text-base font-semibold text-slate-900 group-hover:text-brand-700">{c.name}</h3>
              <p class="mt-0.5 text-xs text-slate-500">{c.powerRange} · {countProductsByCategory(c.slug)} {t.common.models}</p>
            </div>
            <svg class="h-5 w-5 text-slate-400 group-hover:text-brand-600 rtl:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path fill-rule="evenodd" d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z" clip-rule="evenodd" />
            </svg>
          </a>
        ))
      }
    </div>

    {
      categories.map((c) => {
        const inCategory = getProductsByCategory(c.slug).map((p) => localizedProduct(p, locale));
        if (inCategory.length === 0) return null;
        return (
          <div class="mt-14">
            <div class="mb-6 flex items-end justify-between gap-4">
              <div>
                <h3 class="text-xl font-semibold text-slate-900">{c.heading}</h3>
                <p class="mt-1 text-sm text-slate-600">{c.description}</p>
              </div>
              <Button href={localizedPath(locale, `/products/${c.slug}/`)} variant="ghost" class="shrink-0">
                {t.productsIndex.viewCategory} &rarr;
              </Button>
            </div>
            <ProductGrid products={inCategory} locale={locale} />
          </div>
        );
      })
    }
  </Section>

  <CTABanner locale={locale} />
</BaseLayout>

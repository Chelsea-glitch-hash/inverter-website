---
/**
 * Blog / News article template — ONE template for all 11 languages.
 *
 * English is the single source: title/description come from the MDX
 * frontmatter, the body from the MDX content. A locale may override the
 * metadata and provide a translated `bodyHtml` (see src/i18n/blog-content.ts);
 * anything missing falls back to the English article, never to an empty page.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import CTABanner from '../components/CTABanner.astro';
import { render, type CollectionEntry } from 'astro:content';
import { getBlogTranslation } from '../i18n/blog-content';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/config';
import { formatDate, getDict } from '../i18n';
import { SITE } from '../config';

interface Props {
  post: CollectionEntry<'blog'>;
  locale?: Locale;
}
const { post, locale = DEFAULT_LOCALE } = Astro.props;
const t = getDict(locale);

const bt = getBlogTranslation(post.id, locale);
const { Content } = await render(post);

const title = bt.title ?? post.data.title;
const description = bt.description ?? post.data.description;
const tags = bt.tags ?? post.data.tags;
const hasTranslatedBody = locale !== 'en' && Boolean(bt.bodyHtml);

/**
 * BlogPosting structured data.
 *
 * publisher references the site-wide Organization by @id so search engines
 * and AI engines join the article into the existing brand entity rather than
 * inventing a new one per page.
 */
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: post.data.publishDate.toISOString(),
  dateModified: post.data.publishDate.toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': new URL(localizedPath(locale, `/blog/${post.id}/`), SITE.url).href,
  },
  author: { '@type': 'Organization', name: post.data.author, url: SITE.url },
  publisher: { '@id': `${SITE.url}/#organization` },
  ...(tags.length > 0
    ? { keywords: tags.join(', '), articleSection: tags[0] }
    : {}),
  inLanguage: locale === 'zh-hant' ? 'zh-Hant' : locale,
};
---

<BaseLayout title={title} description={description} path={`/blog/${post.id}/`} ogType="article" locale={locale}>
  <script type="application/ld+json" set:html={JSON.stringify(articleJsonLd)} />
  <Container class="pt-8">
    <Breadcrumb crumbs={[{ label: t.blog.breadcrumb, href: localizedPath(locale, '/blog/') }, { label: title }]} locale={locale} />
  </Container>

  <Section>
    <article class="mx-auto max-w-3xl">
      <header class="mb-8">
        <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
          <time datetime={post.data.publishDate.toISOString()}>
            {formatDate(post.data.publishDate, locale)}
          </time>
          <span aria-hidden="true">•</span>
          <span>{post.data.author}</span>
        </div>
        <h1 class="mt-3 text-2xl font-bold text-slate-900 sm:text-3xl">{title}</h1>
        <p class="mt-4 text-base leading-relaxed text-slate-600">{description}</p>
        {tags.length > 0 && (
          <div class="mt-4 flex flex-wrap gap-1.5">
            {tags.map((tag) => (
              <span class="rounded bg-slate-100 px-2 py-0.5 text-xs text-slate-600">{tag}</span>
            ))}
          </div>
        )}
      </header>

      {
        hasTranslatedBody ? (
          <div class="text-base leading-relaxed text-slate-700 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-slate-900 [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-slate-900 [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mb-1 [&_a]:text-brand-700 [&_a]:underline [&_table]:w-full [&_table]:text-sm [&_th]:border [&_th]:border-slate-200 [&_th]:bg-slate-50 [&_th]:p-2 [&_th]:text-left [&_td]:border [&_td]:border-slate-200 [&_td]:p-2" set:html={bt.bodyHtml} />
        ) : (
          <>
            {locale !== 'en' && (
              <p class="mb-6 rounded-xl border border-slate-200 bg-slate-50 p-4 text-xs text-slate-500">
                {t.blog.translatedNote}
              </p>
            )}
            <div class="text-base leading-relaxed text-slate-700 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-slate-900 [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-slate-900 [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mb-1 [&_a]:text-brand-700 [&_a]:underline [&_table]:w-full [&_table]:text-sm [&_th]:border [&_th]:border-slate-200 [&_th]:bg-slate-50 [&_th]:p-2 [&_th]:text-left [&_td]:border [&_td]:border-slate-200 [&_td]:p-2">
              <Content />
            </div>
          </>
        )
      }
    </article>
  </Section>

  <CTABanner title={t.blog.articleCtaTitle} subtitle={t.blog.articleCtaSubtitle} locale={locale} />
</BaseLayout>

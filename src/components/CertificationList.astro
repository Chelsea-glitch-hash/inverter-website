---
/**
 * Certification badges. TODO: replace generic badges with real
 * certification logo images once provided (src/assets/certifications/).
 */
interface Props {
  certifications: string[];
}
const { certifications } = Astro.props;
---

<ul class="flex flex-wrap gap-2.5">
  {
    certifications.map((cert) => (
      <li class="inline-flex items-center gap-1.5 rounded-lg border border-slate-200 bg-slate-50 px-3 py-1.5 text-sm font-medium text-slate-700">
        <svg class="h-4 w-4 text-brand-600" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
          <path
            fill-rule="evenodd"
            d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z"
            clip-rule="evenodd"
          />
        </svg>
        {cert}
      </li>
    ))
  }
</ul>

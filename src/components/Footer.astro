---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import NewsletterForm from './NewsletterForm.astro';
import { SITE, COMPANY, CONTACT, SOCIAL } from '../config';
import { getCategoriesWithProducts } from '../lib/products';
import { localizedCategory } from '../i18n/category-content';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/config';
import { fill, formatDate, getDict } from '../i18n';
import brandLogo from '../assets/brand/logo.png';
import contentDates from '../data/content-dates.json';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getDict(locale);

/* Categories with at least one product — see lib/products.getCategoriesWithProducts.
   Keeps the footer from linking to an empty range. */
const categories = getCategoriesWithProducts().map((c) => localizedCategory(c, locale));

const year = new Date().getFullYear();

/* Newest genuine content date, generated from git history by
   tools/gen-content-dates.mjs — the same source the sitemap <lastmod> uses.
   A build timestamp would claim the page changed on every deploy, which is
   both false and useless as a freshness signal. */
const contentLastUpdated = contentDates._generated;
---

<footer class="border-t border-slate-200 bg-slate-900 text-slate-300">
  <Container>
    <div class="grid grid-cols-1 gap-10 py-14 md:grid-cols-2 lg:grid-cols-4">
      <!-- Company -->
      <div>
        <div class="flex items-center gap-2.5">
          <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-full bg-white"
            aria-hidden="true"
          >
            <Image
              src={brandLogo}
              alt=""
              width={44}
              height={44}
              densities={[1, 2, 3]}
              loading="lazy"
              class="h-11 w-11"
            />
          </span>
          <span class="text-lg font-semibold text-white">{SITE.shortName}</span>
        </div>
        <p class="mt-4 text-sm leading-relaxed text-slate-400">
          {COMPANY.legalName} — {fill(t.footer.blurb, { year: COMPANY.foundedYear, countries: COMPANY.exportCountries })}
        </p>
        <div class="mt-4 flex gap-4 text-sm">
          {
            SOCIAL.instagram && (
              <a href={SOCIAL.instagram} class="text-slate-400 hover:text-white" rel="noopener" target="_blank">
                Instagram
              </a>
            )
          }
          {
            SOCIAL.linkedin && (
              <a href={SOCIAL.linkedin} class="text-slate-400 hover:text-white" rel="noopener" target="_blank">
                LinkedIn
              </a>
            )
          }
          {
            SOCIAL.youtube && (
              <a href={SOCIAL.youtube} class="text-slate-400 hover:text-white" rel="noopener" target="_blank">
                YouTube
              </a>
            )
          }
        </div>
      </div>

      <!-- Products -->
      <nav aria-label={t.footer.productCategoriesAria}>
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase">{t.footer.productsHeading}</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          {
            categories.map((c) => (
              <li>
                <a href={localizedPath(locale, `/products/${c.slug}/`)} class="text-slate-400 hover:text-white">
                  {c.name}
                </a>
              </li>
            ))
          }
          <li><a href={localizedPath(locale, '/products/')} class="text-slate-400 hover:text-white">{t.footer.allProducts}</a></li>
        </ul>
      </nav>

      <!-- Company links -->
      <nav aria-label={t.footer.companyNavAria}>
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase">{t.footer.companyHeading}</h3>
        <ul class="mt-4 space-y-2.5 text-sm">
          <li><a href={localizedPath(locale, '/about/')} class="text-slate-400 hover:text-white">{t.footer.aboutUs}</a></li>
          <li><a href={localizedPath(locale, '/factory/')} class="text-slate-400 hover:text-white">{t.footer.factoryAndManufacturing}</a></li>
          <li><a href={localizedPath(locale, '/quality/')} class="text-slate-400 hover:text-white">{t.footer.qualityControl}</a></li>
          <li><a href={localizedPath(locale, '/blog/')} class="text-slate-400 hover:text-white">{t.footer.blogInsights}</a></li>
          <li><a href={localizedPath(locale, '/tools/sizing-calculator/')} class="text-slate-400 hover:text-white">{t.footer.sizingCalculator}</a></li>
          <li><a href={localizedPath(locale, '/contact/')} class="text-slate-400 hover:text-white">{t.footer.contactUs}</a></li>
          <li><a href={localizedPath(locale, '/privacy-policy/')} class="text-slate-400 hover:text-white">{t.footer.privacyPolicy}</a></li>
        </ul>
      </nav>

      <!-- Contact + newsletter -->
      <div>
        <h3 class="text-sm font-semibold tracking-wider text-white uppercase">{t.footer.stayUpdated}</h3>
        <p class="mt-4 text-sm text-slate-400">
          {t.footer.newsletterBlurb}
        </p>
        <div class="mt-4">
          <NewsletterForm compact locale={locale} />
        </div>
        <ul class="mt-5 space-y-2 text-sm text-slate-400">
          <li>
            <a
              href={`mailto:${CONTACT.email}`}
              class="hover:text-white"
              data-track="click_email"
            >
              {CONTACT.email}
            </a>
          </li>
          {
            CONTACT.whatsapp && (
              <li>
                <a
                  href={`https://wa.me/${CONTACT.whatsapp}`}
                  class="hover:text-white"
                  data-track="click_whatsapp"
                  rel="noopener"
                  target="_blank"
                >
                  WhatsApp: +{CONTACT.whatsapp}
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div class="flex flex-col items-center justify-between gap-3 border-t border-slate-800 py-6 text-xs text-slate-500 sm:flex-row">
      <p>&copy; {year} {COMPANY.legalName}. {t.footer.rights}</p>
      <p>{SITE.url.replace('https://', '')}</p>
    </div>

    <!-- Entity-verification block: registered name, street address and the
         date the site content last changed. These are the three things a
         buyer — or an answer engine deciding whether this is a real company —
         looks for on the page itself rather than buried in structured data. -->
    <div class="border-t border-slate-800 py-6 text-xs leading-relaxed text-slate-500">
      <dl class="flex flex-col gap-1.5">
        <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-2">
          <dt class="shrink-0 sm:w-40">{t.footer.legalNameLabel}</dt>
          <dd class="text-slate-400">{COMPANY.legalName}</dd>
        </div>
        <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-2">
          <dt class="shrink-0 sm:w-40">{t.footer.registeredAddressLabel}</dt>
          <dd class="text-slate-400">
            {COMPANY.address}, {COMPANY.addressLocality}, {COMPANY.addressRegion}, {COMPANY.addressCountry}
          </dd>
        </div>
        <div class="flex flex-col gap-0.5 sm:flex-row sm:gap-2">
          <dt class="shrink-0 sm:w-40">{t.footer.lastUpdatedLabel}</dt>
          <dd class="text-slate-400">
            <time datetime={contentLastUpdated}>{formatDate(new Date(contentLastUpdated), locale)}</time>
          </dd>
        </div>
      </dl>
    </div>
  </Container>
</footer>

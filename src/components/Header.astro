---
import { Image } from 'astro:assets';
import Container from './Container.astro';
import Button from './Button.astro';
import { SITE, CONTACT } from '../config';
import { getCategoriesWithProducts } from '../lib/products';
import { localizedCategory } from '../i18n/category-content';
import { DEFAULT_LOCALE, LOCALE_META, languageSwitcherTargets, localizedPath, type Locale } from '../i18n/config';
import { getDict } from '../i18n';
import brandLogo from '../assets/brand/logo.png';

interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;

const t = getDict(locale);

/* Only categories that actually contain products are listed, so the menu never
   sends a visitor to an empty range. A category reappears here automatically
   once its first product is added to the catalog. */
const categories = getCategoriesWithProducts().map((c) => localizedCategory(c, locale));

const currentPath = Astro.url.pathname;
const navLinks = [
  { href: localizedPath(locale, '/products/'), label: t.nav.products, activePrefix: localizedPath(locale, '/products/') },
  { href: localizedPath(locale, '/factory/'), label: t.nav.factory, activePrefix: localizedPath(locale, '/factory/') },
  { href: localizedPath(locale, '/quality/'), label: t.nav.quality, activePrefix: localizedPath(locale, '/quality/') },
  { href: localizedPath(locale, '/about/'), label: t.nav.about, activePrefix: localizedPath(locale, '/about/') },
  { href: localizedPath(locale, '/blog/'), label: t.nav.blog, activePrefix: localizedPath(locale, '/blog/') },
];

const languages = languageSwitcherTargets(currentPath);
const currentLocaleLabel = LOCALE_META[locale].label;
const isActive = (prefix: string) => currentPath === prefix || currentPath.startsWith(prefix);
---

<header class="sticky top-0 z-40 border-b border-slate-200 bg-white/95 backdrop-blur">
  <Container>
    <div class="flex h-16 items-center justify-between gap-4">
      <!-- Logo -->
      <a href={localizedPath(locale, '/')} class="flex items-center gap-2.5" aria-label={`${SITE.name} home`}>
        <Image
          src={brandLogo}
          alt=""
          width={44}
          height={44}
          densities={[1, 2, 3]}
          loading="eager"
          class="h-11 w-11 shrink-0"
        />
        <span class="text-lg font-semibold text-slate-900">{SITE.shortName}</span>
      </a>

      <!-- Desktop nav -->
      <nav class="hidden items-center gap-6 lg:flex" aria-label={t.nav.mainNavAria}>
        <div class="group relative">
          <a
            href={localizedPath(locale, '/products/')}
            class:list={[
              'py-2 text-sm font-medium transition-colors',
              isActive(localizedPath(locale, '/products/'))
                ? 'text-brand-700'
                : 'text-slate-700 hover:text-brand-700',
            ]}
          >
            {t.nav.products}
            <svg class="ml-1 inline-block h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path
                d="M5.5 7.5 10 12l4.5-4.5"
                stroke="currentColor"
                stroke-width="1.5"
                fill="none"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
          <div class="invisible absolute top-full left-0 z-50 w-56 pt-2 opacity-0 transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
            <div class="rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
              {
                categories.map((c) => (
                  <a
                    href={localizedPath(locale, `/products/${c.slug}/`)}
                    class="block rounded-lg px-3 py-2 text-sm text-slate-700 hover:bg-brand-50 hover:text-brand-700"
                  >
                    {c.name}
                  </a>
                ))
              }
              <a
                href={localizedPath(locale, '/products/')}
                class="block rounded-lg px-3 py-2 text-sm font-medium text-brand-700 hover:bg-brand-50"
              >
                {t.nav.viewAllProducts} &rarr;
              </a>
            </div>
          </div>
        </div>
        {
          navLinks
            .filter((l) => l.href !== localizedPath(locale, '/products/'))
            .map((link) => (
              <a
                href={link.href}
                class:list={[
                  'py-2 text-sm font-medium transition-colors',
                  isActive(link.activePrefix)
                    ? 'text-brand-700'
                    : 'text-slate-700 hover:text-brand-700',
                ]}
              >
                {link.label}
              </a>
            ))
        }
      </nav>

      <div class="hidden items-center gap-3 lg:flex">
        <!-- Language switcher (desktop) -->
        <div class="group relative">
          <button
            type="button"
            class="flex items-center gap-1.5 rounded-lg px-2.5 py-2 text-sm font-medium text-slate-700 transition-colors hover:bg-slate-100 hover:text-brand-700"
            aria-label={t.nav.languageAria}
            aria-haspopup="true"
          >
            <svg class="h-4.5 w-4.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
              <circle cx="12" cy="12" r="9" />
              <path d="M3.6 9h16.8M3.6 15h16.8M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18" />
            </svg>
            <span class="max-w-24 truncate">{currentLocaleLabel}</span>
            <svg class="h-3.5 w-3.5" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
              <path d="M5.5 7.5 10 12l4.5-4.5" stroke="currentColor" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div class="invisible absolute top-full right-0 z-50 w-48 pt-2 opacity-0 transition-opacity group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
            <div class="max-h-80 overflow-y-auto rounded-xl border border-slate-200 bg-white p-2 shadow-lg">
              {
                languages.map(({ locale: target, href }) => (
                  <a
                    href={href}
                    hreflang={LOCALE_META[target].htmlLang}
                    class:list={[
                      'flex items-center justify-between rounded-lg px-3 py-2 text-sm',
                      target === locale
                        ? 'bg-brand-50 font-medium text-brand-700'
                        : 'text-slate-700 hover:bg-brand-50 hover:text-brand-700',
                    ]}
                    aria-current={target === locale ? 'true' : undefined}
                  >
                    <span>{LOCALE_META[target].label}</span>
                    {target === locale && (
                      <svg class="h-4 w-4" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
                        <path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 01.143 1.052l-8 10.5a.75.75 0 01-1.127.075l-4.5-4.5a.75.75 0 011.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 011.05-.143z" clip-rule="evenodd" />
                      </svg>
                    )}
                  </a>
                ))
              }
            </div>
          </div>
        </div>

        <Button href={localizedPath(locale, '/contact/')} variant="primary" track="click_request_quote">
          {t.nav.requestQuote}
        </Button>
      </div>

      <!-- Mobile menu toggle -->
      <button
        id="mobile-menu-toggle"
        class="rounded-lg p-2 text-slate-700 hover:bg-slate-100 lg:hidden"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label={t.nav.toggleMenuAria}
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </button>
    </div>
  </Container>

  <!-- Mobile nav -->
  <nav id="mobile-menu" class="hidden border-t border-slate-200 bg-white lg:hidden" aria-label={t.nav.mobileNavAria}>
    <Container>
      <div class="flex flex-col gap-1 py-4">
        <!-- Language switcher (mobile) -->
        <div class="mb-2">
          <p class="px-3 pb-1.5 text-xs font-semibold tracking-wide text-slate-400 uppercase">{t.nav.languageAria}</p>
          <div class="grid grid-cols-2 gap-1">
            {
              languages.map(({ locale: target, href }) => (
                <a
                  href={href}
                  hreflang={LOCALE_META[target].htmlLang}
                  class:list={[
                    'rounded-lg px-3 py-2 text-sm',
                    target === locale
                      ? 'bg-brand-50 font-medium text-brand-700'
                      : 'text-slate-600 hover:bg-brand-50 hover:text-brand-700',
                  ]}
                  aria-current={target === locale ? 'true' : undefined}
                >
                  {LOCALE_META[target].label}
                </a>
              ))
            }
          </div>
        </div>
        <div class="border-t border-slate-100 pt-2">
          {
            navLinks.map((link) => (
              <a href={link.href} class="rounded-lg px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-brand-50 hover:text-brand-700">
                {link.label}
              </a>
            ))
          }
        </div>
        <div class="mt-2 flex flex-col gap-1 border-t border-slate-100 pt-3">
          {
            categories.map((c) => (
              <a href={localizedPath(locale, `/products/${c.slug}/`)} class="rounded-lg px-3 py-2 text-sm text-slate-600 hover:bg-brand-50 hover:text-brand-700">
                {c.name}
              </a>
            ))
          }
        </div>
        <Button href={localizedPath(locale, '/contact/')} variant="primary" class="mt-3 w-full" track="click_request_quote">
          {t.nav.requestQuote}
        </Button>
        {
          CONTACT.whatsapp && (
            <a
              href={`https://wa.me/${CONTACT.whatsapp}`}
              class="rounded-lg px-3 py-2.5 text-sm font-medium text-brand-700 hover:bg-brand-50"
              data-track="click_whatsapp"
            >
              {t.nav.whatsappUs}
            </a>
          )
        }
      </div>
    </Container>
  </nav>
</header>

<script>
  const toggle = document.getElementById('mobile-menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    toggle.addEventListener('click', () => {
      const open = menu.classList.toggle('hidden') === false;
      toggle.setAttribute('aria-expanded', String(open));
    });
  }
</script>

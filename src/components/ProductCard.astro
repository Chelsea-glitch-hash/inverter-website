---
import Button from './Button.astro';
import { Image } from 'astro:assets';
import { formatPower, productPath, resolveShortDescription, type Product } from '../lib/products';
import { resolveProductImage } from '../lib/product-images';

/**
 * Product card for grids and listings.
 *
 * Everything shown here comes from the product data table
 * (src/data/products.ts) — nothing is hardcoded per product.
 * Images resolve through lib/product-images: optimised assets from
 * src/assets/products/ or public paths under /images/products/.
 * Cards without an image render a neutral placeholder instead of a
 * broken <img>.
 */
interface Props {
  product: Product;
}
const { product } = Astro.props;

const image = resolveProductImage(product.images[0] ?? '');
const href = productPath(product);
const inquiryHref = `/contact/?product=${encodeURIComponent(product.id)}`;
---

<article class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white transition-shadow hover:shadow-lg">
  <div class="aspect-square overflow-hidden bg-slate-50">
    {
      image ? (
        image.kind === 'asset' ? (
          <Image
            src={image.src}
            alt={`${product.name} (${product.id})`}
            width={800}
            height={800}
            class="h-full w-full object-contain p-6 transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <img
            src={image.src}
            alt={`${product.name} (${product.id})`}
            width="800"
            height="800"
            class="h-full w-full object-contain p-6 transition-transform duration-300 group-hover:scale-105"
            loading="lazy"
            decoding="async"
          />
        )
      ) : (
        <div class="flex h-full items-center justify-center text-slate-300">
          <svg class="h-16 w-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <rect x="5" y="2.5" width="14" height="19" rx="2" />
            <path d="M8.5 6h7M8.5 9h7" stroke-linecap="round" />
          </svg>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-center justify-between gap-2">
      <span class="rounded bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700">{product.id}</span>
      <span class="text-xs font-medium text-slate-500">{formatPower(product.ratedPower)}</span>
    </div>
    <h3 class="text-base leading-snug font-semibold text-slate-900">
      <a href={href} class="hover:text-brand-700">{product.name}</a>
    </h3>
    <p class="-mt-1 text-xs font-medium text-slate-500">{product.productType}</p>
    <p class="line-clamp-2 text-sm text-slate-600">{resolveShortDescription(product)}</p>
    <div class="mt-auto flex gap-2 pt-2">
      <Button href={href} variant="outline" class="flex-1 !px-3 !py-2 !text-xs">
        View details
      </Button>
      <Button
        href={inquiryHref}
        variant="primary"
        class="flex-1 !px-3 !py-2 !text-xs"
        track="click_request_quote"
        trackParams={{ product_sku: product.id, product_category: product.category }}
      >
        Get a quote
      </Button>
    </div>
  </div>
</article>

---
import Button from './Button.astro';
import type { CollectionEntry } from 'astro:content';

/**
 * Product card for grids and listings.
 * Image is resolved from the global asset map by path stored in frontmatter.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/products/*.{svg,png,jpg,jpeg,webp,avif}',
  { eager: true }
);

interface Props {
  product: CollectionEntry<'products'>;
}
const { product } = Astro.props;
const p = product.data;

const imagePath = p.images[0] ? `/src/assets/products/${p.images[0]}` : null;
const image = imagePath ? imageModules[imagePath]?.default : undefined;
const inquiryHref = `/contact/?product=${encodeURIComponent(p.sku)}`;
---

<article class="group flex flex-col overflow-hidden rounded-xl border border-slate-200 bg-white transition-shadow hover:shadow-lg">
  <div class="aspect-square overflow-hidden bg-slate-50">
    {
      image ? (
        <Image
          src={image}
          alt={`${p.name} (${p.sku})`}
          width={800}
          height={800}
          class="h-full w-full object-contain p-6 transition-transform duration-300 group-hover:scale-105"
          loading="lazy"
        />
      ) : (
        <div class="flex h-full items-center justify-center text-slate-300">
          <svg class="h-16 w-16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" aria-hidden="true">
            <rect x="5" y="2.5" width="14" height="19" rx="2" />
            <path d="M8.5 6h7M8.5 9h7" stroke-linecap="round" />
          </svg>
        </div>
      )
    }
  </div>

  <div class="flex flex-1 flex-col gap-3 p-5">
    <div class="flex items-center justify-between gap-2">
      <span class="rounded bg-brand-50 px-2 py-0.5 text-xs font-medium text-brand-700">{p.sku}</span>
      {
        p.ratedPower && (
          <span class="text-xs font-medium text-slate-500">
            {p.ratedPower >= 1000 ? `${p.ratedPower / 1000} kW` : `${p.ratedPower} W`}
          </span>
        )
      }
    </div>
    <h3 class="text-base leading-snug font-semibold text-slate-900">
      <a href={`/products/${product.id}/`} class="hover:text-brand-700">{p.name}</a>
    </h3>
    <p class="line-clamp-2 text-sm text-slate-600">{p.shortDescription}</p>
    <div class="mt-auto flex gap-2 pt-2">
      <Button
        href={`/products/${product.id}/`}
        variant="outline"
        class="flex-1 !px-3 !py-2 !text-xs"
      >
        View details
      </Button>
      <Button
        href={inquiryHref}
        variant="primary"
        class="flex-1 !px-3 !py-2 !text-xs"
        track="click_request_quote"
        trackParams={{ product_sku: p.sku, product_category: p.category }}
      >
        Get a quote
      </Button>
    </div>
  </div>
</article>

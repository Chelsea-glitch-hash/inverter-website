---
/**
 * Cookie / consent banner.
 *
 * Architecture (per privacy compliance spec):
 *  - GA4 loads with Consent Mode v2 defaults DENIED (see BaseLayout)
 *  - This banner only gates *marketing/analytics* storage
 *  - Choice persisted in localStorage, applied on every page load
 *  - Strictly necessary storage (UTM attribution for inquiries) is
 *    not gated - it serves the inquiry the user actively submits
 */
import { ANALYTICS } from '../config';
---

{
  ANALYTICS.ga4MeasurementId && (
    <div
      id="consent-banner"
      class="fixed inset-x-0 bottom-0 z-50 hidden border-t border-slate-200 bg-white p-4 shadow-[0_-4px_20px_rgba(0,0,0,0.1)]"
      role="dialog"
      aria-live="polite"
      aria-label="Cookie consent"
    >
      <div class="mx-auto flex max-w-7xl flex-col items-start gap-4 sm:flex-row sm:items-center sm:justify-between">
        <p class="text-sm leading-relaxed text-slate-600">
          We use cookies to understand how the website is used and to improve your
          experience. Marketing cookies are only used with your consent. See our
          <a href="/privacy-policy/" class="font-medium text-brand-700 underline">privacy policy</a>.
        </p>
        <div class="flex shrink-0 gap-3">
          <button
            id="consent-reject"
            class="rounded-lg border border-slate-300 px-4 py-2 text-sm font-medium text-slate-700 hover:bg-slate-50"
          >
            Necessary only
          </button>
          <button
            id="consent-accept"
            class="rounded-lg bg-brand-600 px-4 py-2 text-sm font-medium text-white hover:bg-brand-700"
          >
            Accept all
          </button>
        </div>
      </div>
    </div>
  )
}

<script>
  const CONSENT_KEY = 'consent_mode';
  const GRANTED = { analytics_storage: 'granted', ad_storage: 'granted', ad_user_data: 'granted', ad_personalization: 'granted' };
  const DENIED = { analytics_storage: 'denied', ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied' };

  function applyConsent(mode: 'granted' | 'denied'): void {
    try {
      localStorage.setItem(CONSENT_KEY, JSON.stringify({ mode }));
    } catch {
      /* private mode */
    }
    if (typeof window.gtag === 'function') {
      window.gtag('consent', 'update', mode === 'granted' ? GRANTED : DENIED);
    }
  }

  // Show banner only when no decision has been made yet.
  let saved: string | null = null;
  try {
    const raw = localStorage.getItem(CONSENT_KEY);
    saved = raw ? (JSON.parse(raw) as { mode?: string }).mode ?? null : null;
  } catch {
    saved = null;
  }
  if (!saved) {
    document.getElementById('consent-banner')?.classList.remove('hidden');
  }

  document.getElementById('consent-accept')?.addEventListener('click', () => {
    applyConsent('granted');
    document.getElementById('consent-banner')?.classList.add('hidden');
  });
  document.getElementById('consent-reject')?.addEventListener('click', () => {
    applyConsent('denied');
    document.getElementById('consent-banner')?.classList.add('hidden');
  });
</script>

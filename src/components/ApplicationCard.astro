---
/**
 * Application scenario card.
 */
interface Props {
  title: string;
  description: string;
  icon?: 'sun' | 'battery' | 'industry' | 'home' | 'signal' | 'plug';
}
const { title, description, icon = 'sun' } = Astro.props;

const icons: Record<string, string> = {
  sun: 'M10 2v2m0 12v2M4.93 4.93l1.41 1.41m7.32 7.32 1.41 1.41M2 10h2m12 0h2M6.34 13.66l-1.41 1.41M15.07 4.93l-1.41 1.41M10 6a4 4 0 100 8 4 4 0 000-8z',
  battery: 'M3 8h12a2 2 0 012 2v4a2 2 0 01-2 2H3a2 2 0 01-2-2v-4a2 2 0 012-2zm16 2v4M5 11h6',
  industry: 'M2 20V8l5 4V8l5 4V8l5 4v8H2zm4-4h2m4 0h2',
  home: 'M3 11l9-8 9 8M5 10v10h14V10M9 20v-6h6v6',
  signal: 'M2 20h.01M7 20v-4m5 4V10m5 10V4m5 16V2',
  plug: 'M9 2v6m6-6v6M6 8h12v3a6 6 0 01-6 6 6 6 0 01-6-6V8zm6 9v5',
};
---

<div class="rounded-xl border border-slate-200 bg-white p-6">
  <svg
    class="h-8 w-8 text-brand-600"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="1.6"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d={icons[icon]} />
  </svg>
  <h3 class="mt-4 text-base font-semibold text-slate-900">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-slate-600">{description}</p>
</div>

---
/**
 * Vertical page section with heading + optional eyebrow + subheading.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  class?: string;
  id?: string;
  /**
   * Heading level for `title`. Defaults to "h2" (the correct level for a
   * section nested under a page <h1>). Set to "h1" on the FIRST section of
   * pages whose main heading is rendered through this component, so every
   * page exposes exactly one <h1> (accessibility + SEO).
   */
  titleAs?: 'h1' | 'h2';
}
const { eyebrow, title, subtitle, class: className = '', id, titleAs = 'h2' } = Astro.props;
const TitleTag = titleAs;
---

<section id={id} class:list={['py-16 sm:py-20', className]}>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    {
      (eyebrow || title || subtitle) && (
        <div class="mb-10 max-w-3xl">
          {eyebrow && (
            <p class="mb-2 text-sm font-medium tracking-wide text-brand-600 uppercase">
              {eyebrow}
            </p>
          )}
          {title && (
            <TitleTag class="text-2xl font-semibold text-slate-900 sm:text-3xl">{title}</TitleTag>
          )}
          {subtitle && <p class="mt-4 text-base text-slate-600">{subtitle}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>

---
/**
 * Vertical page section with heading + optional eyebrow + subheading.
 */
interface Props {
  eyebrow?: string;
  title?: string;
  subtitle?: string;
  class?: string;
  id?: string;
}
const { eyebrow, title, subtitle, class: className = '', id } = Astro.props;
---

<section id={id} class:list={['py-16 sm:py-20', className]}>
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    {
      (eyebrow || title || subtitle) && (
        <div class="mb-10 max-w-3xl">
          {eyebrow && (
            <p class="mb-2 text-sm font-medium tracking-wide text-brand-600 uppercase">
              {eyebrow}
            </p>
          )}
          {title && (
            <h2 class="text-2xl font-semibold text-slate-900 sm:text-3xl">{title}</h2>
          )}
          {subtitle && <p class="mt-4 text-base text-slate-600">{subtitle}</p>}
        </div>
      )
    }
    <slot />
  </div>
</section>

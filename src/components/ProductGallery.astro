---
import { Image } from 'astro:assets';
import { resolveProductImages } from '../lib/product-images';

/**
 * Product image gallery with thumbnail switching (progressive JS).
 * Uses <noscript>-friendly markup: first image always visible.
 *
 * Products may not have images yet — in that case a neutral placeholder is
 * rendered so the page layout stays intact and no broken image is emitted.
 * Image references resolve through lib/product-images (optimised asset path
 * or public path).
 */
interface Props {
  sku: string;
  name: string;
  images: string[];
}
const { sku, name, images } = Astro.props;

const resolved = resolveProductImages(images);
---

{
  resolved.length === 0 ? (
    <div class="flex aspect-square items-center justify-center overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
      <div class="px-6 text-center text-slate-300">
        <svg
          class="mx-auto h-20 w-20"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.2"
          aria-hidden="true"
        >
          <rect x="5" y="2.5" width="14" height="19" rx="2" />
          <path d="M8.5 6h7M8.5 9h7" stroke-linecap="round" />
        </svg>
        <p class="mt-3 text-xs font-medium tracking-wide text-slate-400 uppercase">
          Product images coming soon
        </p>
      </div>
      <span class="sr-only">{name} ({sku}) has no product images available yet.</span>
    </div>
  ) : (
    <div class="gallery" data-gallery>
      <div class="overflow-hidden rounded-xl border border-slate-200 bg-slate-50">
        {resolved.map((img, i) =>
          img.kind === 'asset' ? (
            <Image
              src={img.src}
              alt={`${name} (${sku}) — view ${i + 1}`}
              width={800}
              height={800}
              class:list={['gallery-main w-full object-contain p-8', i > 0 && 'hidden']}
              loading={i === 0 ? 'eager' : 'lazy'}
              data-gallery-image={i}
            />
          ) : (
            <img
              src={img.src}
              alt={`${name} (${sku}) — view ${i + 1}`}
              width="800"
              height="800"
              class:list={['gallery-main w-full object-contain p-8', i > 0 && 'hidden']}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              data-gallery-image={i}
            />
          )
        )}
      </div>
      {
        resolved.length > 1 && (
          <div class="mt-3 grid grid-cols-4 gap-3">
            {resolved.map((img, i) => (
              <button
                type="button"
                class="gallery-thumb overflow-hidden rounded-lg border-2 border-transparent bg-slate-50 data-[active=true]:border-brand-500"
                data-gallery-thumb={i}
                aria-label={`Show image ${i + 1}`}
              >
                {img.kind === 'asset' ? (
                  <Image
                    src={img.src}
                    alt=""
                    width={160}
                    height={160}
                    class="aspect-square w-full object-contain p-2"
                    loading="lazy"
                  />
                ) : (
                  <img
                    src={img.src}
                    alt=""
                    width="160"
                    height="160"
                    class="aspect-square w-full object-contain p-2"
                    loading="lazy"
                    decoding="async"
                  />
                )}
              </button>
            ))}
          </div>
        )
      }
    </div>
  )
}

<script>
  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const mains = gallery.querySelectorAll<HTMLElement>('[data-gallery-image]');
    const thumbs = gallery.querySelectorAll<HTMLElement>('[data-gallery-thumb]');
    const activate = (index: number) => {
      mains.forEach((el, i) => el.classList.toggle('hidden', i !== index));
      thumbs.forEach((el, i) => el.dataset.active = String(i === index));
    };
    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => activate(i));
    });
  });
</script>

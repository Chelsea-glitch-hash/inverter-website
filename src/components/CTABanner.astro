---
import Container from './Container.astro';
import Button from './Button.astro';
import { CONTACT } from '../config';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/config';
import { getDict } from '../i18n';

/**
 * "Request a Quote" call-to-action band, reused across pages.
 */
interface Props {
  title?: string;
  subtitle?: string;
  /** Primary button label. Products may override it via `inquiry.buttonText`. */
  buttonText?: string;
  locale?: Locale;
}
const {
  title,
  subtitle,
  buttonText,
  locale = DEFAULT_LOCALE,
} = Astro.props;

const t = getDict(locale);
const resolvedTitle = title ?? t.cta.defaultTitle;
const resolvedSubtitle = subtitle ?? t.cta.defaultSubtitle;
const resolvedButton = buttonText ?? t.cta.defaultButton;
---

<section class="bg-brand-800">
  <Container>
    <div class="flex flex-col items-center gap-6 py-14 text-center sm:py-16">
      <div>
        <h2 class="text-2xl font-semibold text-white sm:text-3xl">{resolvedTitle}</h2>
        <p class="mx-auto mt-3 max-w-2xl text-base text-brand-100">{resolvedSubtitle}</p>
      </div>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <Button href={localizedPath(locale, '/contact/')} variant="secondary" size="lg" track="click_request_quote">
          {resolvedButton}
        </Button>
        {
          CONTACT.whatsapp && (
            <Button
              href={`https://wa.me/${CONTACT.whatsapp}`}
              variant="outline-light"
              size="lg"
              track="click_whatsapp"
            >
              {t.cta.whatsapp}
            </Button>
          )
        }
      </div>
    </div>
  </Container>
</section>

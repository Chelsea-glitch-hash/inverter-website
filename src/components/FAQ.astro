---
/**
 * FAQ accordion (native <details>, zero JS) + FAQPage structured data.
 * Note: per current search engine rules, Google shows FAQ rich results
 * mainly for authoritative sites, but the markup remains valid and
 * useful for Bing / other engines.
 */
interface Props {
  faq: { question: string; answer: string }[];
  title?: string;
}
const { faq, title = 'Frequently Asked Questions' } = Astro.props;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.question,
    acceptedAnswer: { '@type': 'Answer', text: f.answer },
  })),
};
---

<section aria-label={title}>
  <h2 class="mb-6 text-2xl font-semibold text-slate-900">{title}</h2>
  <div class="divide-y divide-slate-200 rounded-xl border border-slate-200 bg-white">
    {
      faq.map((f) => (
        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-sm font-medium text-slate-900 marker:hidden [&::-webkit-details-marker]:hidden">
            {f.question}
            <svg
              class="h-5 w-5 shrink-0 text-slate-400 transition-transform group-open:rotate-180"
              viewBox="0 0 20 20"
              fill="currentColor"
              aria-hidden="true"
            >
              <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
            </svg>
          </summary>
          <p class="mt-3 text-sm leading-relaxed text-slate-600">{f.answer}</p>
        </details>
      ))
    }
  </div>
</section>

<script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

---
/**
 * Download card for datasheets / manuals with stable URLs under
 * /downloads/. Fires the download_datasheet GA4 event.
 */
interface Props {
  sku: string;
  file: string;
  label?: string;
}
const { sku, file, label = 'Product Datasheet (PDF)' } = Astro.props;
const fileName = file.split('/').pop();
---

<a
  href={file}
  download
  class="flex items-center justify-between gap-4 rounded-xl border border-slate-200 bg-white px-5 py-4 transition-colors hover:border-brand-400"
  data-track="download_datasheet"
  data-track-params={JSON.stringify({ product_sku: sku })}
>
  <span class="flex items-center gap-3">
    <svg class="h-8 w-8 text-brand-600" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
      <path
        d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8l-6-6zm0 0v6h6M8 13h8m-8 4h6"
        stroke-linecap="round"
        stroke-linejoin="round"
      />
    </svg>
    <span>
      <span class="block text-sm font-medium text-slate-900">{label}</span>
      <span class="block text-xs text-slate-500">{fileName}</span>
    </span>
  </span>
  <span class="text-sm font-medium text-brand-700">Download</span>
</a>

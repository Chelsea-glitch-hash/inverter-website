---
import Container from './Container.astro';
import { COMPANY } from '../config';
import { DEFAULT_LOCALE, type Locale } from '../i18n/config';
import { getDict } from '../i18n';

/**
 * Trust bar: key manufacturer facts (homepage section 2).
 */
interface Props {
  locale?: Locale;
}
const { locale = DEFAULT_LOCALE } = Astro.props;
const t = getDict(locale);

const facts = [
  { value: `${t.common.since} ${COMPANY.foundedYear}`, label: t.home.trust.manufacturer },
  { value: `${COMPANY.factoryAreaSqm.toLocaleString('en-US')} m²`, label: t.home.trust.factoryArea },
  { value: `${(COMPANY.annualCapacityUnits / 1000).toLocaleString('en-US')}k+`, label: t.home.trust.unitsPerYear },
  { value: `${COMPANY.exportCountries}+`, label: t.home.trust.exportCountries },
  { value: `${COMPANY.oemClients}+`, label: t.home.trust.oemClients },
];
---

<section class="border-y border-slate-200 bg-slate-50" aria-label={t.home.trust.manufacturer}>
  <Container>
    <dl class="grid grid-cols-2 gap-6 py-10 sm:grid-cols-3 lg:grid-cols-5">
      {
        facts.map((f) => (
          <div class="text-center">
            <dt class="order-2 mt-1 text-xs tracking-wide text-slate-500 uppercase">{f.label}</dt>
            <dd class="order-1 text-2xl font-semibold text-brand-700">{f.value}</dd>
          </div>
        ))
      }
    </dl>
  </Container>
</section>

---
/**
 * B2B Inquiry Form — the most important conversion path.
 *
 * Fields: Name, Company, Country, Email, WhatsApp/Phone,
 *         Interested Product (auto-prefilled), Quantity, Message
 *         + separate marketing consent checkbox (default UNCHECKED)
 *         + 18 hidden attribution fields (separate FIRST TOUCH /
 *           LAST TOUCH + meta) + honeypot anti-spam field
 *
 * Submission: Cloudflare Turnstile -> /api/inquiry (Pages Function)
 *             -> Resend -> sales email.
 *
 * Labels follow the page locale; the strings used by the client script are
 * injected as JSON below (an Astro-bundled <script> cannot see frontmatter).
 */
import { TURNSTILE } from '../config';
import { DEFAULT_LOCALE, localizedPath, type Locale } from '../i18n/config';
import { getDict } from '../i18n';

interface Props {
  /** Pre-selected product SKU (from product page CTA) */
  productSku?: string;
  /** Product options for the select, fetched by the page */
  productOptions?: { sku: string; name: string }[];
  locale?: Locale;
}
const { productSku = '', productOptions = [], locale = DEFAULT_LOCALE } = Astro.props;

const t = getDict(locale);
const f = t.form;

const scriptStrings = {
  errorDetail: f.errorDetail,
  fallbackError: f.fallbackError,
  submissionFailed: f.submissionFailed,
};
---

<div
  id="inquiry-form-root"
  data-turnstile-sitekey={TURNSTILE.siteKey}
  class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8"
>
  <h2 class="text-xl font-semibold text-slate-900">{f.title}</h2>
  <p class="mt-2 text-sm text-slate-600">
    {f.subtitle}
  </p>

  <form
    id="inquiry-form"
    class="mt-6 grid grid-cols-1 gap-4 sm:grid-cols-2"
    data-track-form="inquiry"
    novalidate
  >
    <div>
      <label for="if-name" class="mb-1.5 block text-sm font-medium text-slate-700">{f.name} <span class="text-red-500">*</span></label>
      <input id="if-name" name="name" type="text" required autocomplete="name"
        class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200" />
    </div>
    <div>
      <label for="if-company" class="mb-1.5 block text-sm font-medium text-slate-700">{f.company}</label>
      <input id="if-company" name="company" type="text" autocomplete="organization"
        class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200" />
    </div>
    <div>
      <label for="if-country" class="mb-1.5 block text-sm font-medium text-slate-700">{f.country}</label>
      <input id="if-country" name="country" type="text" autocomplete="country-name"
        class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200" />
    </div>
    <div>
      <label for="if-email" class="mb-1.5 block text-sm font-medium text-slate-700">{f.email} <span class="text-red-500">*</span></label>
      <input id="if-email" name="email" type="email" required autocomplete="email"
        class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200" />
    </div>
    <div>
      <label for="if-phone" class="mb-1.5 block text-sm font-medium text-slate-700">{f.phone}</label>
      <input id="if-phone" name="phone" type="tel" autocomplete="tel"
        class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200" />
    </div>
    <div>
      <label for="if-quantity" class="mb-1.5 block text-sm font-medium text-slate-700">{f.quantity}</label>
      <input id="if-quantity" name="quantity" type="text" inputmode="numeric" placeholder={f.quantityPlaceholder}
        class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200" />
    </div>
    <div class="sm:col-span-2">
      <label for="if-product" class="mb-1.5 block text-sm font-medium text-slate-700">{f.product}</label>
      <select id="if-product" name="product"
        class="w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200">
        <option value="">{f.productGeneral}</option>
        {productOptions.map((o) => <option value={o.sku} selected={o.sku === productSku}>{o.sku} — {o.name}</option>)}
      </select>
    </div>
    <div class="sm:col-span-2">
      <label for="if-message" class="mb-1.5 block text-sm font-medium text-slate-700">{f.message} <span class="text-red-500">*</span></label>
      <textarea id="if-message" name="message" rows="4" required
        placeholder={f.messagePlaceholder}
        class="w-full rounded-lg border border-slate-300 px-3.5 py-2.5 text-sm focus:border-brand-500 focus:ring-2 focus:ring-brand-200"></textarea>
    </div>

    <!-- Honeypot: real users never see or fill this -->
    <div class="hp-field" aria-hidden="true">
      <label for="if-website">Website</label>
      <input id="if-website" name="website" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <!-- Marketing consent: SEPARATE from inquiry submission, default unchecked -->
    <div class="sm:col-span-2">
      <label class="flex items-start gap-3 text-sm text-slate-600">
        <input type="checkbox" name="marketing_opt_in" value="yes" class="mt-0.5 h-4 w-4 rounded border-slate-300 text-brand-600 focus:ring-brand-500" />
        <span>{t.newsletter.consent}</span>
      </label>
    </div>

    <!-- Cloudflare Turnstile (rendered when site key is configured) -->
    {TURNSTILE.siteKey && <div class="cf-turnstile sm:col-span-2" data-sitekey={TURNSTILE.siteKey}></div>}

    <!--
      Hidden attribution fields - 18 total.
      Legacy (8) stays last-wins merged values for backward compatibility with v0.1.0.
      Explicit First / Last Touch (10) lets the email show BOTH values cleanly.
      Meta (already in legacy) carries gclid + landing_page + referrer.
    -->
    <input type="hidden" name="attr_source" />
    <input type="hidden" name="attr_medium" />
    <input type="hidden" name="attr_campaign" />
    <input type="hidden" name="attr_term" />
    <input type="hidden" name="attr_content" />
    <input type="hidden" name="attr_gclid" />
    <input type="hidden" name="attr_landing_page" />
    <input type="hidden" name="attr_referrer" />
    <!-- First Touch (preserved across sessions, null if never seen) -->
    <input type="hidden" name="attr_first_source" />
    <input type="hidden" name="attr_first_medium" />
    <input type="hidden" name="attr_first_campaign" />
    <input type="hidden" name="attr_first_term" />
    <input type="hidden" name="attr_first_content" />
    <!-- Last Touch (current session, null if no campaign arrived this session) -->
    <input type="hidden" name="attr_last_source" />
    <input type="hidden" name="attr_last_medium" />
    <input type="hidden" name="attr_last_campaign" />
    <input type="hidden" name="attr_last_term" />
    <input type="hidden" name="attr_last_content" />

    <div class="sm:col-span-2">
      <button
        type="submit"
        class="inline-flex w-full items-center justify-center gap-2 rounded-lg bg-brand-600 px-6 py-3 text-base font-medium text-white transition-colors hover:bg-brand-700 disabled:cursor-not-allowed disabled:opacity-60 sm:w-auto"
      >
        {f.submit}
      </button>
      <p class="mt-3 text-xs text-slate-500">
        {f.consentPrefix}
        <a href={localizedPath(locale, '/privacy-policy/')} class="text-brand-700 underline">{f.consentLink}</a>{f.consentSuffix}
      </p>
    </div>
  </form>

  <!-- Success state -->
  <div id="inquiry-success" class="hidden mt-6 rounded-xl border border-green-200 bg-green-50 p-6" role="status">
    <p class="font-medium text-green-800">{f.successTitle}</p>
    <p class="mt-1 text-sm text-green-700">{f.successText}</p>
  </div>

  <!-- Error state -->
  <div id="inquiry-error" class="hidden mt-6 rounded-xl border border-red-200 bg-red-50 p-6" role="alert">
    <p class="font-medium text-red-800">{f.errorTitle}</p>
    <p id="inquiry-error-detail" class="mt-1 text-sm text-red-700"></p>
  </div>
</div>

<script
  type="application/json"
  id="inquiry-i18n"
  is:inline
  set:html={JSON.stringify(scriptStrings)}
/>

<script>
  import { getAttribution } from '../lib/attribution';
  import { trackEvent } from '../lib/analytics';

  const root = document.getElementById('inquiry-form-root');
  const form = document.getElementById('inquiry-form') as HTMLFormElement | null;
  const success = document.getElementById('inquiry-success');
  const errorBox = document.getElementById('inquiry-error');
  const errorDetail = document.getElementById('inquiry-error-detail');

  // Locale strings injected from the server render (English fallback included).
  let i18n = { errorDetail: '{message} Please try again, or email us directly.', fallbackError: 'Please try again, or email us directly.', submissionFailed: 'Submission failed.' };
  try {
    const el = document.getElementById('inquiry-i18n');
    if (el?.textContent) i18n = { ...i18n, ...(JSON.parse(el.textContent) as typeof i18n) };
  } catch { /* keep English fallback */ }

  function fill(template: string, vars: Record<string, string>): string {
    return template.replace(/\{(\w+)\}/g, (m, key: string) => (key in vars ? vars[key] : m));
  }

  // Load Turnstile widget only when configured.
  const siteKey = root?.dataset.turnstileSitekey;
  if (siteKey && !document.querySelector('script[data-turnstile]')) {
    const s = document.createElement('script');
    s.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
    s.async = true;
    s.defer = true;
    s.dataset.turnstile = 'true';
    document.head.appendChild(s);
  }

  // Prefill product from URL: /contact/?product=HV-5000
  const urlProduct = new URLSearchParams(window.location.search).get('product');
  if (urlProduct) {
    const select = form?.querySelector<HTMLSelectElement>('[name="product"]');
    if (select) {
      const match = [...select.options].find((o) => o.value === urlProduct);
      if (match) select.value = urlProduct;
      else {
        const opt = document.createElement('option');
        opt.value = urlProduct;
        opt.textContent = urlProduct;
        select.prepend(opt);
        select.value = urlProduct;
      }
    }
  }

  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!form || !success || !errorBox || !errorDetail) return;

    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    errorBox.classList.add('hidden');
    success.classList.add('hidden');

    // Inject attribution into hidden fields right before submit.
    // Attribution is split into explicit First Touch / Last Touch, while
    // legacy fields (attr_source/medium/...) carry the last-touch value
    // for full backward compatibility with v0.1.0 payloads.
    const attr = getAttribution();
    const set = (name: string, value: string) => {
      const input = form.querySelector<HTMLInputElement>(`[name="${name}"]`);
      if (input) input.value = value;
    };
    // Legacy flat fields (v0.1.0-compatible, last-wins values)
    set('attr_source',         attr.last?.source || '');
    set('attr_medium',         attr.last?.medium || '');
    set('attr_campaign',       attr.last?.campaign || '');
    set('attr_term',           attr.last?.term || '');
    set('attr_content',        attr.last?.content || '');
    set('attr_gclid',          attr.last?.gclid || '');
    set('attr_landing_page',   attr.landingPage);
    set('attr_referrer',       attr.referrer);
    // Explicit First Touch (cross-session, null-safe)
    set('attr_first_source',   attr.first?.source || '');
    set('attr_first_medium',   attr.first?.medium || '');
    set('attr_first_campaign', attr.first?.campaign || '');
    set('attr_first_term',     attr.first?.term || '');
    set('attr_first_content',  attr.first?.content || '');
    // Explicit Last Touch (current session, null-safe)
    set('attr_last_source',    attr.last?.source || '');
    set('attr_last_medium',    attr.last?.medium || '');
    set('attr_last_campaign',  attr.last?.campaign || '');
    set('attr_last_term',      attr.last?.term || '');
    set('attr_last_content',   attr.last?.content || '');

    const data = Object.fromEntries(new FormData(form).entries());

    try {
      const res = await fetch('/api/inquiry', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      /* A gateway/runtime failure returns an HTML error page, not JSON.
         Read the body as text first so `res.json()` can never throw
         "Unexpected token '<'" at the visitor. */
      const raw = await res.text();
      let result: { ok: boolean; error?: string };
      try {
        result = JSON.parse(raw) as { ok: boolean; error?: string };
      } catch {
        console.error('[inquiry] Non-JSON response', res.status, raw.slice(0, 300));
        throw new Error(i18n.submissionFailed);
      }

      if (res.ok && result.ok) {
        form.classList.add('hidden');
        success.classList.remove('hidden');
        // Core GA4 conversion event, with product + attribution context.
        // Carry forward the last-touch values - same semantics GA4 saw before.
        trackEvent('form_submit', {
          form_type: 'inquiry',
          product_sku: String(data['product'] || ''),
          utm_source:   String(data['attr_source']   || ''),
          utm_medium:   String(data['attr_medium']   || ''),
          utm_campaign: String(data['attr_campaign'] || ''),
        });
      } else {
        throw new Error(result.error || i18n.submissionFailed);
      }
    } catch (err) {
      errorDetail.textContent = fill(i18n.errorDetail, {
        message: err instanceof Error ? err.message : i18n.fallbackError,
      });
      errorBox.classList.remove('hidden');
      if (button) button.disabled = false;
    }
  });
</script>

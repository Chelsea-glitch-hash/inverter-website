---
/**
 * SEO meta tags: unique title, description, canonical, hreflang alternates,
 * Open Graph (with og:locale), Twitter card. Included by BaseLayout.
 *
 * `path` is the canonical ENGLISH path; the canonical URL, the hreflang set
 * and the Open Graph URL are derived from it, so language versions of one
 * page are always mutually linked (no duplicate-content signals).
 */
import { SITE } from '../config';
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, localizedPath, type Locale } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  locale?: Locale;
  /**
   * Site-absolute path of the share image, e.g. "/images/og/products.jpg".
   * Resolved against the site origin so the URL is absolute in the output
   * (Open Graph and Twitter require absolute image URLs).
   */
  ogImage?: string;
}

const {
  title,
  description,
  path,
  ogType = 'website',
  noindex = false,
  locale = DEFAULT_LOCALE,
  ogImage = '/images/og/default.jpg',
} = Astro.props;

const canonicalPath = localizedPath(locale, path);
const canonical = new URL(canonicalPath, Astro.site);
const ogUrl = canonical.toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
/* Only the pre-rendered OG cards are exactly 1200x630; a product photo passed
   as ogImage has its own dimensions, so the size hints are then omitted. */
const isOgCard = ogImage.startsWith('/images/og/');

/**
 * hreflang alternates: one per locale + x-default pointing at English.
 * Every locale exposes the same English path behind its prefix, so all
 * alternates exist by construction.
 */
const alternates = LOCALES.map((l) => ({
  hrefLang: LOCALE_META[l].htmlLang,
  href: new URL(localizedPath(l, path), Astro.site).toString(),
}));
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

{alternates.map((alt) => <link rel="alternate" hreflang={alt.hrefLang} href={alt.href} />)}
<link rel="alternate" hreflang="x-default" href={new URL(path, Astro.site).toString()} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={ogUrl} />
<meta property="og:image" content={ogImageUrl} />
{isOgCard && <meta property="og:image:width" content="1200" />}
{isOgCard && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{LOCALES.filter((l) => l !== locale).map((l) => (
  <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

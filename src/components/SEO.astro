---
/**
 * SEO meta tags: unique title, description, canonical, hreflang alternates,
 * Open Graph (with og:locale), Twitter card. Included by BaseLayout.
 *
 * `path` is the canonical ENGLISH path; the canonical URL, the hreflang set
 * and the Open Graph URL are derived from it, so language versions of one
 * page are always mutually linked (no duplicate-content signals).
 */
import { SITE } from '../config';
import { DEFAULT_LOCALE, LOCALES, LOCALE_META, localizedPath, type Locale } from '../i18n/config';

interface Props {
  title: string;
  description: string;
  path: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  locale?: Locale;
  /**
   * Site-absolute path of the share image, e.g. "/images/og/products.jpg".
   * Resolved against the site origin so the URL is absolute in the output
   * (Open Graph and Twitter require absolute image URLs).
   */
  ogImage?: string;
  /**
   * Override the canonical URL with a site-absolute ENGLISH path.
   *
   * Used by pages that must consolidate onto a different URL than their own —
   * a single-model power page, whose body duplicates its product page, points
   * its canonical (and x-default) at that product page instead. The page keeps
   * its own URL, its own title and its own hreflang set; only the two
   * "preferred URL" signals move. Leave undefined for a normal self-canonical.
   */
  canonicalOverridePath?: string;
}

const {
  title,
  description,
  path,
  ogType = 'website',
  noindex = false,
  locale = DEFAULT_LOCALE,
  ogImage = '/images/og/default.jpg',
  canonicalOverridePath,
} = Astro.props;

/* The page's own path, used for hreflang alternates — a localized page is
   always the English path behind its prefix, even when it consolidates onto
   another URL for canonical purposes. */
const selfPath = localizedPath(locale, path);
/* Canonical target. Defaults to the page itself; a consolidating page passes
   an English path that is then localized the same way, so every locale of the
   pair still points at the same-locale version of the target. */
const canonicalPath = canonicalOverridePath
  ? localizedPath(locale, canonicalOverridePath)
  : selfPath;
const canonical = new URL(canonicalPath, Astro.site);
const ogUrl = canonical.toString();
const ogImageUrl = new URL(ogImage, Astro.site).toString();
/* Only the pre-rendered OG cards are exactly 1200x630; a product photo passed
   as ogImage has its own dimensions, so the size hints are then omitted. */
const isOgCard = ogImage.startsWith('/images/og/');

/**
 * hreflang alternates: one per locale + x-default pointing at English.
 * Every locale exposes the same English path behind its prefix, so all
 * alternates exist by construction.
 *
 * A consolidating page (canonicalOverridePath set) advertises the alternates
 * of its TARGET, not of its own URL: hreflang and canonical must describe the
 * same cluster, otherwise the pair sends Google two contradictory "preferred
 * URL" signals. `alternatePath` is therefore the canonical target when set,
 * and the page's own path otherwise.
 */
const alternatePath = canonicalOverridePath ?? path;
const alternates = LOCALES.map((l) => ({
  hrefLang: LOCALE_META[l].htmlLang,
  href: new URL(localizedPath(l, alternatePath), Astro.site).toString(),
}));

/* RSS autodiscovery — the English feed is the only one, so it is declared on
   every page rather than only on /blog/ (feed readers look for it in <head>). */
const rssUrl = new URL('/rss.xml', Astro.site).toString();
---

<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex ? <meta name="robots" content="noindex, nofollow" /> : <meta name="robots" content="index, follow" />}

<link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Technical Guides`} href={rssUrl} />
{alternates.map((alt) => <link rel="alternate" hreflang={alt.hrefLang} href={alt.href} />)}
<link rel="alternate" hreflang="x-default" href={new URL(localizedPath(DEFAULT_LOCALE, alternatePath), Astro.site).toString()} />

<meta property="og:type" content={ogType} />
<meta property="og:site_name" content={SITE.name} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={ogUrl} />
<meta property="og:image" content={ogImageUrl} />
{isOgCard && <meta property="og:image:width" content="1200" />}
{isOgCard && <meta property="og:image:height" content="630" />}
<meta property="og:image:alt" content={title} />
<meta property="og:locale" content={LOCALE_META[locale].ogLocale} />
{LOCALES.filter((l) => l !== locale).map((l) => (
  <meta property="og:locale:alternate" content={LOCALE_META[l].ogLocale} />
))}
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

---
import ProductCard from './ProductCard.astro';
import type { Product } from '../lib/products';

interface Props {
  products: Product[];
  class?: string;
}
const { products, class: className = '' } = Astro.props;
---

<div class:list={['grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4', className]}>
  {products.map((product) => <ProductCard {product} />)}
</div>

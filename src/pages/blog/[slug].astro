---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Section from '../../components/Section.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CTABanner from '../../components/CTABanner.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={`/blog/${post.id}/`}
  ogType="article"
>
  <Container class="pt-8">
    <Breadcrumb crumbs={[{ label: 'Blog', href: '/blog/' }, { label: post.data.title }]} />
  </Container>

  <Section>
    <article class="mx-auto max-w-3xl">
      <header class="mb-8">
        <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500">
          <time datetime={post.data.publishDate.toISOString()}>
            {post.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          </time>
          <span aria-hidden="true">•</span>
          <span>{post.data.author}</span>
        </div>
        <h1 class="mt-3 text-2xl font-bold text-slate-900 sm:text-3xl">{post.data.title}</h1>
        <p class="mt-4 text-base leading-relaxed text-slate-600">{post.data.description}</p>
      </header>

      <div class="text-base leading-relaxed text-slate-700 [&_h2]:mt-10 [&_h2]:mb-3 [&_h2]:text-xl [&_h2]:font-semibold [&_h2]:text-slate-900 [&_h3]:mt-8 [&_h3]:mb-2 [&_h3]:text-lg [&_h3]:font-semibold [&_h3]:text-slate-900 [&_p]:mb-4 [&_ul]:mb-4 [&_ul]:list-disc [&_ul]:pl-6 [&_li]:mb-1 [&_a]:text-brand-700 [&_a]:underline [&_table]:w-full [&_table]:text-sm [&_th]:border [&_th]:border-slate-200 [&_th]:bg-slate-50 [&_th]:p-2 [&_th]:text-left [&_td]:border [&_td]:border-slate-200 [&_td]:p-2">
        <Content />
      </div>
    </article>
  </Section>

  <CTABanner title="Need Help Choosing an Inverter?" subtitle="Our sales engineers can recommend the right model for your project — free of charge." />
</BaseLayout>

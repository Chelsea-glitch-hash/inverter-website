---
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Breadcrumb from '../components/Breadcrumb.astro';
import InquiryForm from '../components/InquiryForm.astro';
import { getCollection } from 'astro:content';
import { CONTACT, SOCIAL } from '../config';

const products = (await getCollection('products')).sort((a, b) =>
  a.data.sku.localeCompare(b.data.sku)
);
const productOptions = products.map((p) => ({ sku: p.data.sku, name: p.data.name }));
---

<BaseLayout
  title="Contact Us — Request a Quote for Inverters"
  description="Request pricing, datasheets and OEM options for our inverters. Sales engineers reply within 24 hours on business days. Email, WhatsApp and inquiry form available."
  path="/contact/"
>
  <Container class="pt-8">
    <Breadcrumb crumbs={[{ label: 'Contact' }]} />
  </Container>

  <Section eyebrow="Contact" title="Request a Quote" subtitle="Fill in the form and tell us about your project — quantity, target market and technical requirements help us quote faster.">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-5">
      <div class="lg:col-span-3">
        <InquiryForm productOptions={productOptions} />
      </div>

      <div class="space-y-6 lg:col-span-2">
        <div class="rounded-xl border border-slate-200 bg-slate-50 p-6">
          <h3 class="text-base font-semibold text-slate-900">Direct contact</h3>
          <ul class="mt-4 space-y-3 text-sm text-slate-700">
            <li>
              <span class="block text-xs font-medium text-slate-500 uppercase">Email</span>
              <a
                href={`mailto:${CONTACT.email}`}
                class="font-medium text-brand-700 hover:underline"
                data-track="click_email"
              >
                {CONTACT.email}
              </a>
            </li>
            {
              CONTACT.whatsapp && (
                <li>
                  <span class="block text-xs font-medium text-slate-500 uppercase">WhatsApp</span>
                  <a
                    href={`https://wa.me/${CONTACT.whatsapp}`}
                    class="font-medium text-brand-700 hover:underline"
                    rel="noopener"
                    target="_blank"
                    data-track="click_whatsapp"
                  >
                    +{CONTACT.whatsapp}
                  </a>
                </li>
              )
            }
            <li>
              <span class="block text-xs font-medium text-slate-500 uppercase">Phone</span>
              <span class="font-medium text-slate-900">{CONTACT.phone}</span>
            </li>
            <li>
              <span class="block text-xs font-medium text-slate-500 uppercase">Response time</span>
              <span class="font-medium text-slate-900">Within 24 hours on business days</span>
            </li>
          </ul>
          {
            SOCIAL.linkedin && (
              <a href={SOCIAL.linkedin} class="mt-4 inline-block text-sm font-medium text-brand-700 hover:underline" rel="noopener" target="_blank">
                Connect on LinkedIn &rarr;
              </a>
            )
          }
        </div>

        <div class="rounded-xl border border-slate-200 bg-white p-6">
          <h3 class="text-base font-semibold text-slate-900">Before you write</h3>
          <ul class="mt-3 space-y-2 text-sm leading-relaxed text-slate-600">
            <li>• Have a datasheet? Attach it in your reply email.</li>
            <li>• Tell us your destination country — certifications differ by market.</li>
            <li>• Volume buyers: ask about OEM branding and exclusive distribution.</li>
          </ul>
        </div>
      </div>
    </div>
  </Section>
</BaseLayout>

---
/** English power-rating page — thin wrapper around the shared template. */
import PowerPage from '../../../templates/PowerPage.astro';
import {
  POWER_CATEGORY_PARENT,
  getPowerCategories,
  type PowerCategory,
} from '../../../lib/power-categories';

export function getStaticPaths() {
  return getPowerCategories(POWER_CATEGORY_PARENT).map((powerCategory) => ({
    params: { power: powerCategory.slug },
    props: { powerCategory },
  }));
}

interface Props {
  powerCategory: PowerCategory;
}
const { powerCategory } = Astro.props;
---

<PowerPage powerCategory={powerCategory} locale="en" />

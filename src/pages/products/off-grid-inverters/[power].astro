---
/** English power-rating page — thin wrapper around the shared template. */
import PowerPage from '../../../templates/PowerPage.astro';
import { getPowerCategories } from '../../../lib/power-categories';

export function getStaticPaths() {
  const parentCategory = 'off-grid-inverters';
  return getPowerCategories(parentCategory).map((powerCategory) => ({
    params: { power: powerCategory.slug },
    props: { parentCategory, powerCategory },
  }));
}

const { parentCategory, powerCategory } = Astro.props;
---

<PowerPage parentCategory={parentCategory} powerCategory={powerCategory} locale="en" />

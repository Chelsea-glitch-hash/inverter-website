---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Section from '../../../components/Section.astro';
import CTABanner from '../../../components/CTABanner.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ProductGrid from '../../../components/ProductGrid.astro';
import { getCategory } from '../../../lib/categories';
import { getPowerCategories, powerCategoryPath } from '../../../lib/power-categories';
import { getCategoriesWithProducts, getProductsByCategory } from '../../../lib/products';

export function getStaticPaths() {
  /* Only categories that hold at least one real product get a page. A category
     waiting for its first model is not published as an empty listing — and the
     page appears by itself as soon as a product with that category is added. */
  return getCategoriesWithProducts().map((category) => ({
    params: { category: category.slug },
  }));
}

const { category } = Astro.params;
const meta = getCategory(category!);
const products = getProductsByCategory(category!);

/* Power-level sub-categories (currently only for the off-grid range), derived
   from the product data. A power level with no models never links anywhere. */
const powerCategories = getPowerCategories(category!).map((power) => ({
  ...power,
  count: products.filter((p) => p.ratedPower === power.power).length,
}));
---

<BaseLayout
  title={`${meta?.heading ?? 'Products'} — Manufacturer & OEM Supplier`}
  description={meta?.description ?? 'Inverter product category.'}
  path={`/products/${category}/`}
>
  <Container class="pt-8">
    <Breadcrumb crumbs={[{ label: 'Products', href: '/products/' }, { label: meta?.name ?? '' }]} />
  </Container>

  <Section eyebrow="Product Category" title={meta?.heading ?? 'Products'} subtitle={meta?.description}>
    {
      products.length > 0 ? (
        <ProductGrid products={products} />
      ) : (
        <p class="rounded-xl border border-dashed border-slate-300 bg-slate-50 p-8 text-center text-sm text-slate-500">
          Models for this category are being prepared. Contact us for the latest catalog.
        </p>
      )
    }
  </Section>

  {
    powerCategories.length > 0 && (
      <Section
        class="bg-slate-50"
        eyebrow="Shop by Power"
        title={meta ? `${meta.name} by Rated Power` : 'Browse by Rated Power'}
        subtitle="Choose the output power you need — each page lists every model available at that rating."
      >
        <ul class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
          {powerCategories.map((power) => (
            <li>
              <a
                href={powerCategoryPath(category!, power.slug)}
                class="group flex items-center justify-between gap-3 rounded-xl border border-slate-200 bg-white p-5 transition-colors hover:border-brand-400 hover:bg-brand-50"
              >
                <span>
                  <span class="block text-base font-semibold text-slate-900 group-hover:text-brand-700">
                    {power.name}
                  </span>
                  <span class="mt-0.5 block text-xs text-slate-500">
                    {power.count} {power.count === 1 ? 'model' : 'models'}
                  </span>
                </span>
                <svg
                  class="h-5 w-5 shrink-0 text-slate-400 group-hover:text-brand-600"
                  viewBox="0 0 20 20"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path
                    fill-rule="evenodd"
                    d="M3 10a.75.75 0 01.75-.75h10.638L10.23 5.29a.75.75 0 111.04-1.08l5.5 5.25a.75.75 0 010 1.08l-5.5 5.25a.75.75 0 11-1.04-1.08l4.158-3.96H3.75A.75.75 0 013 10z"
                    clip-rule="evenodd"
                  />
                </svg>
              </a>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <CTABanner
    title="Need a Custom Specification?"
    subtitle="We develop custom inverters for OEM/ODM projects — power rating, firmware, branding and certifications tailored to your market."
  />
</BaseLayout>

---
/** English product category page — thin wrapper around the shared template. */
import CategoryPage from '../../../templates/CategoryPage.astro';
import { getCategoriesWithProducts } from '../../../lib/products';

export function getStaticPaths() {
  /* Only categories that hold at least one real product get a page. A category
     waiting for its first model is not published as an empty listing — and the
     page appears by itself as soon as a product with that category is added. */
  return getCategoriesWithProducts().map((category) => ({
    params: { category: category.slug },
  }));
}

const { category } = Astro.params;
---

<CategoryPage category={category!} locale="en" />

---
/** English product detail page — thin wrapper around the shared template. */
import ProductDetailPage from '../../../templates/ProductDetailPage.astro';
import { getAllProducts, type Product } from '../../../lib/products';

export function getStaticPaths() {
  return getAllProducts().map((product) => ({
    params: { category: product.category, product: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;
---

<ProductDetailPage product={product} locale="en" />

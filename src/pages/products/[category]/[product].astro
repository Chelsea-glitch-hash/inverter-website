---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import Section from '../../../components/Section.astro';
import Button from '../../../components/Button.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import ProductGallery from '../../../components/ProductGallery.astro';
import SpecTable from '../../../components/SpecTable.astro';
import FeatureList from '../../../components/FeatureList.astro';
import CertificationList from '../../../components/CertificationList.astro';
import FAQ from '../../../components/FAQ.astro';
import DownloadCard from '../../../components/DownloadCard.astro';
import ProductGrid from '../../../components/ProductGrid.astro';
import CTABanner from '../../../components/CTABanner.astro';
import { getCategory } from '../../../lib/categories';
import { getPowerCategoryForProduct, powerCategoryPath } from '../../../lib/power-categories';
import {
  formatPower,
  getAllProducts,
  getRelatedProducts,
  productPath,
  resolveSeo,
  resolveShortDescription,
  toPackagingRows,
  toSpecRows,
  type Product,
} from '../../../lib/products';
import { SITE } from '../../../config';

/**
 * Product detail page — a pure template.
 *
 * It holds NO product data: the URL picks a record out of the catalog
 * (src/data/products.ts) and renders it. Add a product to the data table and
 * its page exists; there is nothing to edit here.
 */
export function getStaticPaths() {
  return getAllProducts().map((product) => ({
    params: { category: product.category, product: product.slug },
    props: { product },
  }));
}

interface Props {
  product: Product;
}
const { product: p } = Astro.props;

const categoryMeta = getCategory(p.category);
/** Power-level sub-category (off-grid range only) — enables the 4-level breadcrumb. */
const powerCategory = getPowerCategoryForProduct(p);

const related = getRelatedProducts(p, 4);
const relatedInCategory = related.filter((item) => item.category === p.category).length;

/** SEO: authored copy wins, otherwise composed from the product's real fields. */
const seo = resolveSeo(p);

const specRows = toSpecRows(p);
const packagingRows = toPackagingRows(p.packaging);

const overview = p.overview ?? [];
const features = p.features ?? [];
const certifications = p.certifications ?? [];
const applications = p.applications ?? [];
const faq = p.faq ?? [];

const heroImage = p.images[0];

/* Product structured data. Offer markup intentionally omitted until
   real pricing data exists (per SEO spec: only use with real data). */
const productJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.name,
  sku: p.id,
  mpn: p.id,
  description: seo.description,
  category: categoryMeta?.name ?? p.category,
  brand: { '@type': 'Brand', name: SITE.name },
  ...(heroImage ? { image: heroImage } : {}),
  ...(certifications.length > 0
    ? {
        additionalProperty: certifications.map((c) => ({
          '@type': 'PropertyValue',
          name: 'Certification',
          value: c,
        })),
      }
    : {}),
};

const inquiryHref = `/contact/?product=${encodeURIComponent(p.id)}`;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  path={productPath(p)}
  ogType="product"
  pageType="product"
  productSku={p.id}
  productCategory={p.category}
>
  <script type="application/ld+json" set:html={JSON.stringify(productJsonLd)} />

  <Container class="pt-8">
    <Breadcrumb
      crumbs={[
        { label: 'Products', href: '/products/' },
        { label: categoryMeta?.name ?? p.category, href: `/products/${p.category}/` },
        ...(powerCategory
          ? [
              {
                label: powerCategory.name,
                href: powerCategoryPath(p.category, powerCategory.slug),
              },
            ]
          : []),
        { label: p.id },
      ]}
    />
  </Container>

  <!-- Product hero: gallery + key info -->
  <Container class="pt-6 pb-4">
    <div class="grid grid-cols-1 gap-10 lg:grid-cols-2">
      <ProductGallery sku={p.id} name={p.name} images={p.images} />

      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="rounded bg-brand-50 px-2.5 py-1 text-xs font-semibold text-brand-700">{p.id}</span>
          {p.featured && <span class="rounded bg-accent-100 px-2.5 py-1 text-xs font-semibold text-accent-600">Featured</span>}
          <span class="rounded bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">
            {formatPower(p.ratedPower)} rated output
          </span>
          {
            p.series && (
              <span class="rounded bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">
                {p.series}
              </span>
            )
          }
        </div>

        <h1 class="mt-4 text-2xl font-bold text-slate-900 sm:text-3xl">{p.name}</h1>
        <p class="mt-2 text-sm font-medium text-slate-500">{p.productType}</p>
        <p class="mt-4 text-base leading-relaxed text-slate-600">{resolveShortDescription(p)}</p>

        {
          certifications.length > 0 && (
            <div class="mt-6">
              <CertificationList certifications={certifications} />
            </div>
          )
        }

        <div class="mt-8 flex flex-wrap gap-3">
          <Button
            href={inquiryHref}
            variant="primary"
            size="lg"
            track="click_request_quote"
            trackParams={{ product_sku: p.id, product_category: p.category }}
          >
            Get a Quote for This Model
          </Button>
          <Button href="/contact/" variant="outline" size="lg">
            Contact Sales
          </Button>
        </div>

        <ul class="mt-6 space-y-2 text-sm text-slate-600">
          <li>• OEM / ODM branding available for volume orders</li>
          <li>• Datasheet and pricing on request</li>
          <li>• Reply within 24 hours on business days</li>
        </ul>
      </div>
    </div>
  </Container>

  <!-- Overview -->
  {
    overview.length > 0 && (
      <Section title="Product Overview">
        <div class="max-w-3xl space-y-4 text-base leading-relaxed text-slate-700">
          {overview.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </Section>
    )
  }

  <!-- Technical specifications -->
  {
    specRows.length > 0 && (
      <Section title="Technical Specifications" class="bg-slate-50">
        <div class="max-w-3xl">
          <SpecTable specs={specRows} />
        </div>
      </Section>
    )
  }

  <!-- Features -->
  {
    features.length > 0 && (
      <Section title="Key Features">
        <FeatureList features={features} />
      </Section>
    )
  }

  <!-- Packaging information -->
  {
    packagingRows.length > 0 && (
      <Section title="Packaging Information" class="bg-slate-50">
        <div class="max-w-3xl">
          <SpecTable specs={packagingRows} fallbackGroup="Packaging Information" />
        </div>
      </Section>
    )
  }

  <!-- Applications -->
  {
    applications.length > 0 && (
      <Section title="Applications" class="bg-slate-50">
        <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {applications.map((app) => (
            <li class="flex items-start gap-3 rounded-xl border border-slate-200 bg-white p-5">
              <span class="mt-1 inline-block h-2 w-2 shrink-0 rounded-full bg-accent-500" aria-hidden="true" />
              <span class="text-sm text-slate-700">{app}</span>
            </li>
          ))}
        </ul>
      </Section>
    )
  }

  <!-- Downloads -->
  {
    p.datasheet && (
      <Section title="Downloads">
        <div class="max-w-xl">
          <DownloadCard sku={p.id} file={p.datasheet} />
        </div>
      </Section>
    )
  }

  <!-- FAQ -->
  {
    faq.length > 0 && (
      <Section class="bg-slate-50">
        <FAQ faq={faq} />
      </Section>
    )
  }

  <!-- Related products -->
  {
    related.length > 0 && (
      <Section
        title="Related Products"
        subtitle={
          relatedInCategory >= 3
            ? `More options in ${categoryMeta?.name ?? 'this category'}`
            : 'More models from our catalog'
        }
      >
        <ProductGrid products={related} />
      </Section>
    )
  }

  <CTABanner
    title={p.inquiry?.headline}
    subtitle={p.inquiry?.text}
    buttonText={p.inquiry?.buttonText}
  />
</BaseLayout>

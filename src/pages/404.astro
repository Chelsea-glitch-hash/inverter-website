---
/**
 * 404 — served by Cloudflare Pages for any URL that does not match a route.
 *
 * Two things matter here:
 *   1. `noindex` — a 404 must never enter the index (SEO.astro honours it).
 *   2. Real internal links — a lost visitor is one click away from the
 *      catalog or the inquiry form instead of a dead end.
 *
 * English only on purpose: Cloudflare serves this one file for every locale
 * and every unmatched path, so there is no locale context to translate into.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Container from '../components/Container.astro';
import Section from '../components/Section.astro';
import Button from '../components/Button.astro';

const links = [
  { href: '/products/', label: 'Browse the inverter catalog' },
  { href: '/products/off-grid-inverters/', label: 'Off-grid inverters' },
  { href: '/products/off-grid-solar-inverters/', label: 'Off-grid solar inverters' },
  { href: '/about/', label: 'About the factory' },
  { href: '/blog/', label: 'Technical guides' },
];
---

<BaseLayout
  title="Page Not Found | Zhongze Huasong"
  description="The page you requested could not be found. Browse our off-grid inverter catalog or contact our sales team for the right model."
  path="/404/"
  noindex
>
  <Section>
    <Container>
      <div class="mx-auto max-w-2xl py-10 text-center">
        <p class="text-sm font-semibold tracking-wide text-brand-600 uppercase">404</p>
        <h1 class="mt-3 text-2xl font-bold text-slate-900 sm:text-3xl">We could not find that page</h1>
        <p class="mt-4 text-base leading-relaxed text-slate-600">
          The link may be outdated or mistyped. Start from the catalog below, or
          tell us the specification you need and our sales engineers will point
          you to the right model — usually within 24 hours.
        </p>

        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <Button href="/products/" variant="primary" size="lg">Browse Inverters</Button>
          <Button href="/contact/" variant="outline" size="lg">Contact Sales</Button>
        </div>

        <nav aria-label="Popular pages" class="mt-10">
          <h2 class="text-xs font-semibold tracking-wider text-slate-500 uppercase">Popular pages</h2>
          <ul class="mt-4 flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm">
            {
              links.map((link) => (
                <li>
                  <a href={link.href} class="text-brand-700 underline hover:text-brand-800">
                    {link.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </Container>
  </Section>
</BaseLayout>

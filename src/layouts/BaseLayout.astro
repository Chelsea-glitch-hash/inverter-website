---
import '../styles/global.css';
import SEO from '../components/SEO.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ConsentBanner from '../components/ConsentBanner.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ChatWidget from '../components/ChatWidget.astro';
import { SITE, COMPANY, CONTACT, ANALYTICS, SOCIAL } from '../config';
import { DEFAULT_LOCALE, meta, type Locale } from '../i18n/config';
import { getDict } from '../i18n';

interface Props {
  title: string;
  description: string;
  /**
   * Canonical ENGLISH path of the page, e.g. "/products/off-grid-inverters/".
   * The localized URL, hreflang alternates and canonical are derived from it.
   */
  path: string;
  ogType?: 'website' | 'article' | 'product';
  noindex?: boolean;
  /**
   * Site-absolute share image path, e.g. "/images/og/products.jpg".
   * Defaults to the site-wide OG card.
   */
  ogImage?: string;
  /** body data attributes for analytics */
  pageType?: string;
  productSku?: string;
  productCategory?: string;
  /** Current locale. English pages may omit it. */
  locale?: Locale;
}

const {
  title,
  description,
  path,
  ogType = 'website',
  noindex = false,
  ogImage,
  pageType,
  productSku,
  productCategory,
  locale = DEFAULT_LOCALE,
} = Astro.props;

const t = getDict(locale);
const localeMeta = meta(locale);

/**
 * Organization structured data (site-wide).
 *
 * `@id` matters for GEO: every other entity on the site (WebSite.publisher,
 * Product.brand, BlogPosting.publisher) references the Organization by that
 * id, so AI engines can join the scattered mentions into one brand entity.
 */
const ORG_ID = `${SITE.url}/#organization`;

/* External profiles that corroborate the brand entity. SOCIAL entries stay
   empty until real accounts exist, so sameAs is only emitted when non-empty. */
const sameAs = [SOCIAL.linkedin, SOCIAL.youtube].filter(Boolean);

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  '@id': ORG_ID,
  name: COMPANY.legalName,
  alternateName: SITE.name,
  url: SITE.url,
  logo: {
    '@type': 'ImageObject',
    url: new URL('/images/og/logo.png', SITE.url).href,
    width: 512,
    height: 512,
  },
  description: `${COMPANY.legalName} is a professional inverter manufacturer providing OEM/ODM services for global B2B customers.`,
  foundingDate: String(COMPANY.foundedYear),
  address: {
    '@type': 'PostalAddress',
    streetAddress: COMPANY.address,
    addressLocality: COMPANY.addressLocality,
    addressRegion: COMPANY.addressRegion,
    addressCountry: COMPANY.addressCountry,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'sales',
    telephone: CONTACT.phone,
    email: CONTACT.email,
    availableLanguage: ['en', 'zh'],
  },
  ...(sameAs.length > 0 ? { sameAs } : {}),
};

/** WebSite entity: declares the site name and ties it to the Organization. */
const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: SITE.url,
  name: SITE.name,
  description: SITE.tagline,
  publisher: { '@id': ORG_ID },
  inLanguage: 'en',
};
---

<!doctype html>
<html lang={localeMeta.htmlLang} dir={localeMeta.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="generator" content={Astro.generator} />
    <SEO
      title={title}
      description={description}
      path={path}
      ogType={ogType}
      noindex={noindex}
      locale={locale}
      ogImage={ogImage}
    />

    <!-- GA4 with Consent Mode v2: all marketing/analytics storage denied until consent -->
    {
      ANALYTICS.ga4MeasurementId && (
        <script is:inline define:vars={{ measurementId: ANALYTICS.ga4MeasurementId }}>
          window.dataLayer = window.dataLayer || [];
          function gtag() { dataLayer.push(arguments); }
          gtag('consent', 'default', {
            analytics_storage: 'denied',
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
          });
          // Re-apply a saved decision so returning visitors keep their choice.
          try {
            var saved = JSON.parse(localStorage.getItem('consent_mode') || 'null');
            if (saved && saved.mode === 'granted') {
              gtag('consent', 'update', {
                analytics_storage: 'granted',
                ad_storage: 'granted',
                ad_user_data: 'granted',
                ad_personalization: 'granted',
              });
            }
          } catch (e) {}
          gtag('js', new Date());
          gtag('config', measurementId);
        </script>
      )
    }

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
  </head>

  <body
    class="flex min-h-screen flex-col"
    data-page-type={pageType}
    data-product-sku={productSku}
    data-product-category={productCategory}
    data-lang={locale}
  >
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:rounded focus:bg-brand-600 focus:px-4 focus:py-2 focus:text-white"
    >
      {t.nav.skipToContent}
    </a>
    <Header locale={locale} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <ChatWidget locale={locale} />
    <WhatsAppButton locale={locale} />
    <ConsentBanner locale={locale} />

    <script>
      import '../scripts/tracking';
    </script>
  </body>
</html>

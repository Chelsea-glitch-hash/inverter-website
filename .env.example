# =====================================================================
# Server-side secrets for Cloudflare Pages Functions.
# Copy values into: Cloudflare Dashboard -> Pages -> Settings ->
# Environment variables (Production + Preview).
# NEVER commit real values to Git.
# =====================================================================

# Resend (transactional email only - inquiry notifications)
# https://resend.com/api-keys
RESEND_API_KEY=

# Where inquiry notifications are delivered (sales inbox)
INQUIRY_TO_EMAIL=

# Verified Resend sender, e.g. "Website Inquiry <inquiry@your-domain.com>"
# For local testing only, Resend allows: onboarding@resend.dev
INQUIRY_FROM_EMAIL=

# Cloudflare Turnstile secret key (server-side verification)
# https://dash.cloudflare.com -> Turnstile
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------
# AI Sales Chat (/api/chat, /api/chat-lead)
#
# The chat works WITHOUT any of these: the deterministic rules engine in
# src/lib/chat-engine.ts still answers, recommends real products from
# src/data/products.ts, captures leads and hands off to sales. These
# variables only add the language-model layer that rephrases the answer.
#
# NONE of these may ever be exposed to the browser: they are read only by
# the Pages Functions. Never put them in src/config.ts or a PUBLIC_* name.
# ---------------------------------------------------------------------

# Master switch for the AI layer. "true" enables it; anything else
# (including empty) leaves the chat running on rules only.
CHAT_AI_ENABLED=

# OpenAI-compatible provider. AI_MODEL is server-owned — the browser can
# never choose or override it. No provider or model is hardcoded in the code:
# the AI layer only activates when ALL THREE of AI_API_KEY, AI_API_BASE and
# AI_MODEL are set (plus CHAT_AI_ENABLED=true). Leave them blank to run on
# the rules engine alone.
#   OpenAI       https://api.openai.com/v1          gpt-4o-mini
#   DeepSeek     https://api.deepseek.com/v1        deepseek-chat
#   Qwen         https://dashscope.aliyuncs.com/compatible-mode/v1   qwen-plus
#   Moonshot     https://api.moonshot.cn/v1         moonshot-v1-8k
#   Groq         https://api.groq.com/openai/v1     llama-3.3-70b-versatile
AI_API_KEY=
AI_API_BASE=
AI_MODEL=

# Turns allowed in one conversation before it is handed to a human (2-20).
CHAT_MAX_TURNS=8

# Company contact details shown INSIDE the chat, and only after a lead has
# been stored. Leave blank to use the values in src/config.ts.
CHAT_CONTACT_EMAIL=
CHAT_CONTACT_WHATSAPP=

# ---------------------------------------------------------------------
# Newsletter / EDM platform (phase 2 hook, e.g. Brevo / Mailchimp).
# The /api/newsletter function forwards subscriptions when configured.
# ---------------------------------------------------------------------
NEWSLETTER_API_URL=
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=

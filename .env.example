# =====================================================================
# Server-side secrets for Cloudflare Pages Functions.
# Copy values into: Cloudflare Dashboard -> Pages -> Settings ->
# Environment variables (Production + Preview).
# NEVER commit real values to Git.
# =====================================================================

# Resend (transactional email only - inquiry notifications)
# https://resend.com/api-keys
RESEND_API_KEY=

# Where inquiry notifications are delivered (sales inbox)
INQUIRY_TO_EMAIL=

# Verified Resend sender, e.g. "Website Inquiry <inquiry@your-domain.com>"
# For local testing only, Resend allows: onboarding@resend.dev
INQUIRY_FROM_EMAIL=

# Cloudflare Turnstile secret key (server-side verification)
# https://dash.cloudflare.com -> Turnstile
TURNSTILE_SECRET_KEY=

# ---------------------------------------------------------------------
# Newsletter / EDM platform (phase 2 hook, e.g. Brevo / Mailchimp).
# The /api/newsletter function forwards subscriptions when configured.
# ---------------------------------------------------------------------
NEWSLETTER_API_URL=
NEWSLETTER_API_KEY=
NEWSLETTER_LIST_ID=
